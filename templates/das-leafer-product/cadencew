#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$ROOT_DIR/.cadence/bin"
BIN="$BIN_DIR/cadence"
BIN_HASH="$BIN.sha256"
VENDOR_CORE="$ROOT_DIR/vendor/cadence/cadence-oss/cadence-core"
VENDOR_RECEIPT="$ROOT_DIR/vendor/cadence/.cadence-vendor-lock.json"

validate_vendor() {
  [[ -f "$VENDOR_RECEIPT" && -d "$VENDOR_CORE" ]] || {
    echo "cadencew: no verified local Cadence vendor; run scripts/install_cadence_vendor.sh" >&2; exit 127; }
  python3 - "$VENDOR_RECEIPT" <<'PY'
import json, os, sys
doc = json.load(open(sys.argv[1], encoding="utf-8"))
component = doc.get("components", {}).get("cadence-oss", {})
mode = doc.get("mode")
if mode == "verified-release" and component.get("publication", {}).get("status") == "eligible":
    raise SystemExit(0)
if (
    mode == "development-override"
    and os.environ.get("DAS_LEAFER_ALLOW_UNSAFE_VENDOR")
    and not os.environ.get("CI")
    and not os.environ.get("DAS_RELEASE_PROFILE")
):
    raise SystemExit(0)
raise SystemExit("cadencew: vendor receipt is not a publication-eligible release identity")
PY
}

validate_cached_binary() {
  [[ -x "$BIN" && -f "$BIN_HASH" ]] || return 1
  local expected actual
  expected="$(awk '{print $1}' "$BIN_HASH")"; actual="$(sha256sum "$BIN" | awk '{print $1}')"
  [[ "$expected" == "$actual" ]] || { echo "cadencew: cached binary hash mismatch" >&2; exit 1; }
  return 0
}

validate_vendor
if ! validate_cached_binary; then
  mkdir -p "$BIN_DIR"
  temp_bin="$BIN_DIR/.cadence.$$.tmp"
  (cd "$VENDOR_CORE" && go build -o "$temp_bin" ./cmd/cadence)
  chmod 0755 "$temp_bin"
  sha256sum "$temp_bin" > "$BIN_HASH.tmp"
  mv "$temp_bin" "$BIN"; mv "$BIN_HASH.tmp" "$BIN_HASH"
fi
exec "$BIN" "$@"
